{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/_lab/co.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/_lab/co.js",
      "destination": "https://cdn.jsdelivr.net/gh/leonidstern/labit@latest/co/co.js"
    },
    {
      "source": "/_lab/co/comments",
      "destination": "/api/comments"
    }
  ]
}
